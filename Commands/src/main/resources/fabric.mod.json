{
  "schemaVersion": 1,
  "id": "commands",
  "version": "${version}",
  "name": "Commands",
  "description": "A Bukkit-adjacent API for registering namespaced commands in Fabric",
  "authors": ["beemerwt"],
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "main": [
      "com.github.beemerwt.commands.Commands"
    ]
  },
  "mixins": [ "commands.mixins.json" ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  }
}
